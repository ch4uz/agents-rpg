{
  "name": "agents-rpg",
  "version": "0.0.1",
  "private": true,
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint 'src/**/*.ts' 'src/**/*.tsx' 'tests/**/*.ts' 'tests/**/*.tsx'",
    "format": "prettier --write 'src/**/*.ts' 'src/**/*.tsx' 'tests/**/*.ts' 'tests/**/*.tsx'",
    "typecheck": "tsc --noEmit",
    "play": "tsx bin/play.ts",
    "dashboard": "tsx bin/dashboard.ts",
    "start:web": "tsx bin/play.ts --browser scenarios/basement-o-rats.json",
    "install:animations": "tsx bin/install-pixellab-animations.ts",
    "dev:web": "vite",
    "build:web": "vite build",
    "preview:web": "vite preview"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.30.1",
    "@dimforge/rapier3d-compat": "^0.19.3",
    "@google-cloud/storage": "^7.19.0",
    "@google/genai": "^1.52.0",
    "ink": "^5.2.1",
    "lit-html": "^3.3.2",
    "open": "^11.0.0",
    "pixi.js": "^8.18.1",
    "react": "^18.3.1",
    "three": "^0.184.0",
    "ws": "^8.20.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.12.0",
    "@types/react": "^18.3.28",
    "@types/three": "^0.184.1",
    "@types/ws": "^8.18.1",
    "@typescript-eslint/eslint-plugin": "^7.7.0",
    "@typescript-eslint/parser": "^7.7.0",
    "eslint": "^8.57.0",
    "ink-testing-library": "^4.0.0",
    "jsdom": "^29.1.1",
    "prettier": "^3.2.5",
    "tsx": "^4.21.0",
    "typescript": "^5.4.0",
    "vite": "^8.0.11",
    "vitest": "^1.5.0"
  }
}
